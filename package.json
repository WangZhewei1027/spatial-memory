{
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/check-client-bundles.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:scene-authoring": "npm --prefix packages/scene-authoring test",
    "test:scene-renderer": "npm --prefix packages/scene-renderer test",
    "test:integration": "node --import tsx --conditions react-server scripts/test-content-model-services.ts && node --import tsx --conditions react-server scripts/test-team-workbench-routes.ts && node --import tsx --conditions react-server scripts/test-upload-dedup.ts && node --import tsx --conditions react-server scripts/test-thumbnail-backfill.ts && node --import tsx --conditions react-server scripts/test-activities.ts",
    "test:cross-runtime": "tsx scripts/test-three-editor.ts && tsx scripts/test-scene-playback-parity.ts && tsx scripts/test-scene-performance-parity.ts",
    "test:cli-auth": "node --import tsx --conditions react-server scripts/test-cli-auth-client.mjs",
    "check:fast": "npm run typecheck && npm run lint && npm test",
    "check": "npm run check:fast && npm run build",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:codegen": "kysely-codegen --dialect postgres --out-file lib/db/types.ts --default-schema public --include-pattern \"{public,auth}.*\" --exclude-pattern \"{spatial_ref_sys,geometry_columns,geography_columns}\"",
    "deploy": "scripts/deploy.sh"
  },
  "dependencies": {
    "@alicloud/credentials": "^2.4.5",
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@spatial-memory/scene-core": "file:packages/scene-core",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mdx": "^2.0.13",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.7",
    "busboy": "1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exifr": "^7.1.3",
    "geist": "^1.7.2",
    "i18next": "^25.7.3",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "lucide-react": "^0.511.0",
    "mermaid": "^11.15.0",
    "next": "latest",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-i18next": "^16.5.0",
    "react-photo-view": "^1.2.7",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "three": "^0.183.2",
    "undici": "^7.30.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@redux-devtools/extension": "^3.3.0",
    "@types/ali-oss": "^6.23.3",
    "@types/busboy": "1.5.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "kysely-codegen": "^0.20.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "name": "spatial-memory"
}
